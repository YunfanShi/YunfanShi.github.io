# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
NEXT_PUBLIC_COMPANION_OAUTH_CLIENT_ID=your-companion-oauth-client-id
COMPANION_V1_ENABLED=false
AI_CONFIG_ENCRYPTION_KEY=base64-encoded-32-byte-key

# Auth - 允许访问的 GitHub 用户名（逗号分隔）
AUTHORIZED_GITHUB_USERS=YunfanShi

# Auth - 邮箱白名单（逗号分隔）
AUTHORIZED_EMAILS=w.jack2025a@gmail.com,w.jack2025a@outlook.com

# App
NEXT_PUBLIC_SITE_URL=https://jackyun.top

# Network portal - 仅服务端。分别使用两个独立、至少 32 字符的随机值。
# NETWORK_PORTAL_ENTRY_KEY=router-only-entry-key
# NETWORK_PORTAL_SESSION_SECRET=server-only-session-signing-secret

# ── LLM Proxy (Cloud API Key) — 仅服务端可访问 ──
# ⚠️ 请勿在任何前端代码中暴露此 Key！
# CLOUD_LLM_API_URL=https://api.deepseek.com
# CLOUD_LLM_API_KEY=sk-your-deepseek-key-here
# CLOUD_LLM_MODEL=deepseek-v4-flash
# 仅当使用自建/其他 OpenAI 兼容服务时填写主机名，逗号分隔；不要填 URL 或路径。
# ALLOWED_LLM_HOSTS=llm.example.com

# ── Resend（仅服务端） ──
# RESEND_API_KEY=re_xxxxxxxxx
# RESEND_FROM_EMAIL=JackYun Portal <support@your-domain.com>
# BUG_REPORT_RECIPIENT_EMAIL=admin@example.com
