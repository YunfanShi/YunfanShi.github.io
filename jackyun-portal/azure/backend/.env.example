SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=
PGHOST=YOUR_SERVER.postgres.database.azure.com
PGDATABASE=jackyun_migration_YYYYMMDD
PGUSER=jackyun_sync_login
PGPASSWORD=
PGSSLROOTCERT=/etc/ssl/certs/ca-certificates.crt
PORT=8080
# v5 rollout: disabled | test-users | canary | percentage | global
SYNC_V5_MODE=test-users
SYNC_V5_USERS=
SYNC_V5_SCOPES=
SYNC_V5_PERCENTAGE=0
SYNC_V5_PERCENTAGE_SALT=
# Reject new v5 mutations while preserving reads and receipt lookups.
SYNC_V5_WRITE_PAUSE=false
