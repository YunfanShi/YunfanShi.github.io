import assert from 'node:assert/strict';
import {createRequire} from 'node:module';
import {mkdir,writeFile} from 'node:fs/promises';
import {createEmptyScheduleState,type StudyCue} from '../src/lib/learning/schedule-control.ts';
const require=createRequire(import.meta.url),{chromium}=require(process.env.JACKYUN_PLAYWRIGHT_PATH||'playwright');
const base=process.env.JACKYUN_TEST_URL||'http://localhost:3215',out=process.env.JACKYUN_SCREENSHOT_DIR||'artifacts/verification/cue-search';await mkdir(out,{recursive:true});
const now=new Date().toISOString();
const cue=(id:string,values:Partial<StudyCue>):StudyCue=>({id,subjectId:'physics',subjectName:'Physics',unit:'Kinematics',subsection:'',prompt:'Unknown',type:'general',markingPoints:[],intervalDays:0,easeFactor:2.5,streak:0,status:'unclear',createdAt:now,updatedAt:now,...values});
const seed=createEmptyScheduleState();seed.settings.tutorialSeenVersion=1;seed.cues=[cue('ms',{prompt:'MS-only card',markingPoints:['change in velocity'],version:3,intervalDays:4,streak:2,lastReviewedAt:'2026-10-17T10:00:00.000Z',nextReviewDate:'2026-10-25'}),cue('answer',{prompt:'Answer-only card',answer:'velocity is a vector'}),cue('subtitle',{prompt:'Subtitle-only card',subtitle:'recall velocity'}),cue('title',{prompt:'Velocity'}),cue('place',{prompt:'Location-only card',unit:'Velocity'}),cue('typo',{prompt:'Velocitty'}),cue('mass',{prompt:'Mass'}),cue('biomass',{prompt:'Biomass'})];seed.cueReviews=[{id:'review-ms',cueId:'ms',status:'partial',note:'保留复习记录',reviewedAt:'2026-10-17T10:00:00.000Z',nextReviewDate:'2026-10-25',intervalDays:4,easeFactor:2.4}];seed.cueMemos=[{cueId:'ms',content:'保留备忘录',updatedAt:'2026-10-18T10:00:00.000Z'}];
const browser=await chromium.launch({headless:true,channel: process.env.JACKYUN_BROWSER_CHANNEL || 'msedge'}),results:unknown[]=[];
try{for(const width of [1440,390]){
 const context=await browser.newContext({viewport:{width,height:1000},timezoneId:'Asia/Shanghai'});await context.addInitScript(seed=>localStorage.setItem('jackyun_schedule_control_v1',JSON.stringify(seed)),seed);
 const page=await context.newPage(),errors:string[]=[];page.on('pageerror',(e:Error)=>errors.push(e.message));await page.goto(base+'/schedule');if(width<768){const mobileManagement=page.getByRole('button',{name:'打开日程管理'});await mobileManagement.waitFor({state:'visible',timeout:20000});await mobileManagement.click();}else{await page.getByRole('navigation',{name:'日程视图',exact:true}).waitFor({timeout:20000});}const openManager=page.getByRole('button',{name:/Cue 管理/});try{await openManager.waitFor({state:'visible',timeout:20000});await openManager.click({timeout:20000});}catch(error){const body=await page.locator('body').innerText().catch(()=>'<body unavailable>');throw new Error(`Cue manager did not open at ${base} (${width}px): ${String(error)}\n${body.slice(-1200)}\nPage errors: ${errors.join('; ')}`);}
 const dialog=page.getByRole('dialog',{name:'知识 CUE 管理'}),query=dialog.getByRole('searchbox',{name:'搜索 Cue 管理'});const actions=dialog.locator('article').first().getByRole('button');assert.ok(await actions.count()>=3);for(const action of await actions.all()){const target=await action.evaluate(element=>({height:element.getBoundingClientRect().height,width:element.getBoundingClientRect().width,touchAction:getComputedStyle(element).touchAction}));assert.ok(target.height>=44,`Cue management actions stay at least 44px tall at ${width}px`);assert.ok(target.width>=44,`Cue management actions stay at least 44px wide at ${width}px`);assert.equal(target.touchAction,'manipulation');}
 await query.fill('velocity');await dialog.locator('article').nth(3).waitFor();assert.equal(await dialog.locator('article').count(),4);const cards=await dialog.locator('article').allTextContents();assert.match(cards[0],/命中大标题/);assert.match(cards[1],/命中小标题/);assert.match(cards[2],/命中答案/);assert.match(cards[3],/命中MS/);assert.equal(await dialog.locator('mark').count(),4);
 await page.screenshot({path:out+'/cue-search-'+width+'.png'});await query.fill('mass');assert.equal(await dialog.locator('article').count(),1);assert.match(await dialog.locator('article').textContent(),/Mass/);
 await query.fill('veloctiy');await dialog.getByRole('status').filter({hasText:'已扩大'}).waitFor();assert.ok(await dialog.locator('article').count()>0);assert.ok(await dialog.locator('mark').count()>0);
 await query.fill('velocity energy');assert.equal(await dialog.locator('article').count(),0);await dialog.getByText('还没有匹配的 Cue。',{exact:true}).waitFor();await query.fill('');assert.equal(await dialog.locator('article').count(),8);await dialog.locator('article').first().screenshot({path:out+`/cue-actions-${width}.png`});
 const firstCard=dialog.locator('article').first();await firstCard.getByRole('button',{name:'编辑 Cue',exact:true}).click();await dialog.getByRole('textbox',{name:'题目大标题'}).fill('MS-only card 已改写');await dialog.getByRole('textbox',{name:'参考答案（可选）'}).fill('velocity evidence remains');await dialog.getByRole('button',{name:'保存修改',exact:true}).click();await dialog.getByRole('status').filter({hasText:'修改已保存，学习历史与备忘录保留。'}).waitFor();await page.waitForFunction(()=>{const state=JSON.parse(localStorage.getItem('jackyun_schedule_control_v1')||'{}');return state.cues?.find((item: {id:string})=>item.id==='ms')?.prompt==='MS-only card 已改写';});const saved=await page.evaluate(()=>JSON.parse(localStorage.getItem('jackyun_schedule_control_v1')||'{}'));const edited=saved.cues.find((item:{id:string})=>item.id==='ms');assert.equal(edited.version,4);assert.equal(edited.status,'unclear');assert.equal(edited.intervalDays,4);assert.equal(edited.streak,2);assert.equal(edited.nextReviewDate,'2026-10-25');assert.deepEqual(saved.cueReviews,[{...seed.cueReviews[0]}]);assert.deepEqual(saved.cueMemos,[{...seed.cueMemos[0]}]);assert.ok(await dialog.getByText('MS-only card 已改写',{exact:true}).count());
 assert.equal(errors.length,0,errors.join('\n'));results.push({width,passed:true,checks:['priority order','MS search','literal highlighting','no biomass substring','fallback typo','all-token requirement','clear query']});await context.close();
}}finally{await browser.close();}await writeFile(out+'/cue-search-results.json',JSON.stringify(results,null,2));console.log(JSON.stringify(results));
