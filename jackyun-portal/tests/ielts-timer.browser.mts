import assert from 'node:assert/strict';
import { createRequire } from 'node:module';
import { readFileSync, mkdirSync, writeFileSync } from 'node:fs';
import { createServer } from 'node:http';
import { createEmptyScheduleState } from '../src/lib/learning/schedule-control.ts';
import { validateSession, validateConfig } from '../src/lib/learning/practice-timer.ts';
const require=createRequire(import.meta.url),{chromium}=require(process.env.JACKYUN_PLAYWRIGHT_PATH||'playwright');
const out=process.env.JACKYUN_SCREENSHOT_DIR||'../docs/practice-ielts-3.26.0/verification';mkdirSync(out,{recursive:true});
const seed=createEmptyScheduleState();seed.timetable={version:1,name:'Fixture',courses:[{id:'physics',name:'Physics',color:'#abcdef',review:true,sessions:[]}]};
let validated=0;
const server=createServer(async(req,res)=>{
 const path=req.url?.split('?')[0];
 if(path==='/api/practice-timer/live'){res.writeHead(401,{'Content-Type':'application/json'});res.end('{}');return;}
 if(path==='/validate'){try{let body='';for await(const chunk of req)body+=chunk;const m=JSON.parse(body);if(m.session)validateSession(m.session);if(m.config)validateConfig(m.config);validated++;res.end('{}');}catch(error){res.writeHead(400);res.end(String(error));}return;}
 if(path==='/'){res.setHeader('Content-Type','text/html');res.end(`<html><body style="margin:0"><iframe title="timer" src="/PracticeTimer.html" style="border:0;width:100vw;height:100vh"></iframe><script>let state=JSON.parse(localStorage.getItem('fixture')||'null')||${JSON.stringify(seed)};addEventListener('message',async e=>{const m=e.data;if(m.type==='practice-ready')e.source.postMessage({type:'practice-state',state},location.origin);if(m.type==='practice-save'){const r=await fetch('/validate',{method:'POST',body:JSON.stringify(m)});if(!r.ok)throw Error(await r.text());if(m.session)state.practiceSessions=(state.practiceSessions||[]).filter(s=>s.id!==m.session.id).concat(m.session);if(m.config)state.practiceTimerConfig=m.config;localStorage.setItem('fixture',JSON.stringify(state));e.source.postMessage({type:'practice-saved',requestId:m.requestId},location.origin);}});</script></body></html>`);return;}
 const name=path?.slice(1)||'';if(!/^(PracticeTimer\.html|practice-[a-z-]+\.(js|css))$/.test(name)){res.writeHead(404);res.end();return;}res.setHeader('Content-Type',name.endsWith('html')?'text/html':name.endsWith('css')?'text/css':'text/javascript');res.end(readFileSync('public/'+name));
});
await new Promise<void>(r=>server.listen(0,'127.0.0.1',r));const base='http://127.0.0.1:'+(server.address() as any).port;
const browser=await chromium.launch({headless:true,channel:'msedge'}),results:any[]=[];
try{for(const width of [1440,390]){
 const ctx=await browser.newContext({viewport:{width,height:1000}}),page=await ctx.newPage(),errors:string[]=[];page.on('pageerror',(e:Error)=>errors.push(e.message));await page.clock.install({time:new Date("2026-10-17T12:00:00+08:00")});await page.clock.pauseAt(new Date("2026-10-17T12:00:01+08:00"));await page.goto(base);const f=page.frameLocator('iframe');await f.locator('#create').waitFor({state:'visible'});
 await f.locator('#contentType').selectOption('pastPaper');await f.locator('#scope').fill('Physics correction');await f.locator('#create').click();await f.locator('#toggle').click();await page.clock.runFor(20000);
 await f.locator('#workspaceTypeButton').click();await page.clock.runFor(3000);await f.locator('#types button').nth(1).click();assert.match(await f.locator('#used').textContent(),/00:23/);assert.match(await f.locator('#runStatus').textContent(),/正在计时/);
 await f.locator('#enterFocus').click();await page.keyboard.press('1');assert.match(await f.locator('#used').textContent(),/00:23/);await page.keyboard.press('Escape');await f.locator('#toggle').click();await f.locator('#workspaceTypeButton').click();await f.locator('#types button').nth(1).click();assert.match(await f.locator('#used').textContent(),/00:23/);assert.match(await f.locator('#runStatus').textContent(),/已暂停/);await page.screenshot({path:`${out}/correction-${width}.png`});await f.locator('#finish').click();await f.locator('#newSession').click();
 // IELTS works without timetable courses as well as alongside existing ones.
 await page.evaluate(()=>{const s=JSON.parse(localStorage.getItem('fixture')!);s.timetable.courses=[];s.practiceSessions=[];localStorage.setItem('fixture',JSON.stringify(s));});await page.reload();await f.locator('#practiceKind').selectOption('ielts');
 for(const [section,count] of [['writing',2],['reading',3],['speaking',3],['listening',1]] as const){
  await f.locator('#practiceKind').selectOption('ielts');await f.locator('#ieltsSection').selectOption(section);assert.equal(await f.locator('#setupTypes button').count(),count);assert.equal(await f.locator('#timingPresetHint').isVisible(),false);assert.equal(await f.locator('#create').isEnabled(),true);await f.locator('#contentType').selectOption('pastPaper');await f.locator('#scope').fill('IELTS '+section);await page.screenshot({path:`${out}/${section}-setup-${width}.png`});await f.locator('#create').click();await f.locator('#workspace').waitFor({state:'visible'});assert.equal(await f.locator('#queue button').count(),count);assert.match(await f.locator('#clock').textContent(),section==='writing'||section==='reading'?/20:00/:section==='listening'?/32:00/:/05:00/);
  await f.locator('#toggle').click();await page.clock.runFor(10000);
  if(count>1){await f.locator('#next').click();await page.clock.runFor(5000);await f.locator('#queue button').first().click();assert.match(await f.locator('#used').textContent(),/00:10/);assert.equal(await f.locator('#totalTime').textContent(),'00:15');await f.locator('#workspaceTypeButton').click();await f.locator('#types button').nth(1).click();assert.match(await f.locator('#used').textContent(),/00:05/);assert.equal(await f.locator('#queue button').count(),count);}
  if(section==='speaking'){await page.clock.runFor(55000);assert.match(await f.locator('#ieltsPhase').textContent(),/陈述/);}
  if(section==='listening'){await page.clock.runFor(1790000);assert.match(await f.locator('#ieltsPhase').textContent(),/最后 2 分钟/);assert.equal(await f.locator('#clock').textContent(),'02:00');await page.clock.runFor(120000);assert.match(await f.locator('#ieltsPhase').textContent(),/已结束/);assert.equal(await f.locator('#next').isVisible(),false);}
  await f.locator('#toggle').click();await page.waitForFunction(()=>JSON.parse(localStorage.getItem('fixture')!).practiceSessions.some((s:any)=>s.ieltsSection&&s.questions.some((q:any)=>q.elapsedMs>0)));const used=await f.locator('#used').textContent();if(section==='writing'){await f.locator('#workspaceSettingsButton').click();assert.equal(await f.locator('[data-settings-tab=course]').isVisible(),false);await f.locator('#soundEnabled').uncheck();await f.locator('#saveSettings').click();assert.equal(await f.locator('#used').textContent(),used);}await page.screenshot({path:`${out}/${section}-workspace-${width}.png`});assert.equal(await f.locator('body').evaluate((el:HTMLElement)=>el.scrollWidth<=innerWidth+1),true);
  await page.reload();await f.locator('#historyRows button').filter({hasText:'IELTS '+({writing:'Writing',reading:'Reading',speaking:'Speaking',listening:'Listening'}[section])}).first().click();await f.locator('#workspace').waitFor({state:'visible'});assert.equal(await f.locator('#used').textContent(),used);assert.match(await f.locator('#toggle').textContent(),/开始计时/);await f.locator('#finish').click();await f.locator('#report').waitFor({state:'visible'});await f.locator('#newSession').click();
 }
 assert.deepEqual(errors,[]);results.push({width,sections:4,correctionRunningAndPaused:true,focusCorrection:true,noTimetableRequired:true,partTimesPreserved:true,reloadAndReport:true,listeningCheckBoundary:true,errors});await ctx.close();
}}finally{await browser.close();server.close();}
writeFileSync(out+'/results.json',JSON.stringify({results,validatedSaves:validated},null,2));console.log(JSON.stringify(results));
