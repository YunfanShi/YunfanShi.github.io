import assert from 'node:assert/strict';
import { createRequire } from 'node:module';
import { readFileSync, mkdirSync, writeFileSync } from 'node:fs';
import { createServer } from 'node:http';
import { createEmptyScheduleState } from '../src/lib/learning/schedule-control.ts';
const require=createRequire(import.meta.url),{chromium}=require(process.env.JACKYUN_PLAYWRIGHT_PATH||'playwright');
const seed=createEmptyScheduleState();seed.practiceSessions=[];seed.timetable={version:1,name:'Test',courses:[{id:'phy',name:'Physics',color:'#abcdef',kind:'class'}],terms:[],slots:[],events:[]};
let live:any=null,saves=0,hold=false;const out='artifacts/verification/practice-cloud';mkdirSync(out,{recursive:true});
const server=createServer(async(req,res)=>{
 if(req.url==='/api/practice-timer/live'){
  let text='';for await(const chunk of req)text+=chunk;const data=text?JSON.parse(text):null;res.setHeader('Content-Type','application/json');
  if(data?.action==='claim'){if(live?.payload&&!live.payload.session.finished&&live.payload.session.id!==data.sessionId){res.statusCode=409;res.end(JSON.stringify({conflict:'ACTIVE_SESSION',payload:live.payload}));return;}live={...live,ownerId:data.owner,token:crypto.randomUUID(),revision:(live?.revision||0)+1};}
  else if(data){if(hold){res.statusCode=503;res.end(JSON.stringify({error:'offline'}));return;}if(live?.ownerId!==data.owner||live?.token!==data.token){res.statusCode=409;res.end(JSON.stringify({conflict:'LOST_CONTROL'}));return;}if(data.action==='save'){assert.equal(data.revision,live.revision);live.payload=data.payload;live.payload.session.questions.forEach((q:any)=>{if(q.startedAt!==null)q.startedAt=Date.now();});live.revision++;saves++;} }
  res.end(JSON.stringify({...live,savedAt:new Date().toISOString(),serverNow:Date.now()}));return;
 }
 if(req.url==='/'){res.setHeader('Content-Type','text/html');res.end(`<html><body style="margin:0"><iframe title="timer" src="/PracticeTimer.html" style="border:0;width:100vw;height:100vh"></iframe><script>let state=${JSON.stringify(seed)};addEventListener('message',e=>{const m=e.data;if(m.type==='practice-ready')e.source.postMessage({type:'practice-state',state},location.origin);if(m.type==='practice-save'){if(m.session){state.practiceSessions=state.practiceSessions.filter(s=>s.id!==m.session.id).concat(m.session);}if(m.config)state.practiceTimerConfig=m.config;e.source.postMessage({type:'practice-saved',requestId:m.requestId},location.origin);}});</script></body></html>`);return;}
 const name=req.url?.slice(1).split('?')[0]||'';if(!/^(PracticeTimer\.html|practice-[a-z-]+\.(js|css))$/.test(name)){res.statusCode=404;res.end();return;}res.setHeader('Content-Type',name.endsWith('.html')?'text/html':name.endsWith('.css')?'text/css':'text/javascript');res.end(readFileSync('public/'+name));
});await new Promise<void>(r=>server.listen(0,'127.0.0.1',r));const base='http://127.0.0.1:'+(server.address() as any).port;
async function advance(page:any,ms:number){for(let rest=ms;rest>0;rest-=5000){await page.clock.runFor(Math.min(5000,rest));await new Promise(r=>setTimeout(r,70));}}
const browser=await chromium.launch({headless:true,channel:'msedge'});const errors:string[]=[];
try{
 const a=await browser.newContext({viewport:{width:1440,height:1000}}),pa=await a.newPage();pa.on('pageerror',(e:Error)=>errors.push(e.message));await pa.clock.install({time:new Date()});await pa.goto(base);const fa=pa.frameLocator('iframe');await fa.locator('#contentType').selectOption('pastPaper');await fa.locator('#scope').fill('Paper 2');await fa.locator('#create').click();await fa.locator('#workspace').waitFor({state:'visible'});await fa.locator('#questionInfoButton').click();await fa.locator('#questionLimit').fill('1');await fa.locator('#questionLimit').press('Tab');await fa.locator('#closeQuestionInfo').click();await fa.locator('#toggle').click();await fa.locator('#runStatus').getByText('正在计时',{exact:false}).waitFor();await pa.clock.runFor(1000);await pa.waitForFunction(()=>true);const initial=saves;await advance(pa,42000);assert.equal(await fa.locator('body').getAttribute('data-tone'),'yellow');assert.match(await fa.locator('#phaseStatus').textContent(),/黄色/);await pa.screenshot({path:out+'/yellow.png'});await advance(pa,14000);assert.equal(await fa.locator('body').getAttribute('data-tone'),'red');await pa.screenshot({path:out+'/red.png'});await advance(pa,6000);assert.equal(await fa.locator('body').getAttribute('data-tone'),'overtime');await fa.locator('#cloudStatus').getByText('已保存云端',{exact:false}).waitFor();await new Promise(r=>setTimeout(r,250));assert.ok(saves>initial,'minute checkpoint');
 await fa.locator('#enterFocus').click();await fa.locator('#next').click();await fa.locator('#typePicker').waitFor({state:'visible'});assert.match(await fa.locator('#typePickerTitle').textContent(),/立即开始/);assert.match(await fa.locator('#types button').first().textContent(),/分钟/);await fa.locator('#types button').first().click();await fa.locator('#runStatus').getByText('正在计时',{exact:false}).waitFor();assert.match(await fa.locator('#questionLabel').textContent(),/第 2 题/);await pa.clock.runFor(8000);await fa.locator('#toggle').click();assert.match(await fa.locator('#runStatus').textContent(),/已暂停/);const elapsed=await fa.locator('#used').textContent();await pa.clock.runFor(5000);assert.equal(await fa.locator('#used').textContent(),elapsed);await pa.screenshot({path:out+'/desktop-paused.png'});
 const b=await browser.newContext({viewport:{width:390,height:844}}),pb=await b.newPage();pb.on('pageerror',(e:Error)=>errors.push(e.message));await pb.goto(base);const fb=pb.frameLocator('iframe');await fb.locator('#resumeCloud').click();await fb.locator('#workspace').waitFor({state:'visible'});assert.match(await fb.locator('#questionLabel').textContent(),/第 2 题/);assert.equal(await fb.locator('#used').textContent(),elapsed);await pa.clock.runFor(10000);await fa.locator('#handoff').waitFor({state:'visible'});assert.equal(await fa.locator('#workspace').isVisible(),false);await fb.locator('#toggle').click();assert.match(await fb.locator('#runStatus').textContent(),/正在计时/);await pb.screenshot({path:out+'/mobile-inherited.png'});hold=true;await pb.clock.install({time:new Date()});await pb.clock.runFor(11000);await fb.locator('#handoff').waitFor({state:'visible'});assert.deepEqual(errors,[]);writeFileSync(out+'/results.json',JSON.stringify({minuteCheckpoint:true,nextTypeAutoStart:true,pauseFrozen:true,deviceHandoff:true,offlineStops:true,errors},null,2));console.log('Practice cloud browser flow passed');
}finally{await browser.close();server.close();}
