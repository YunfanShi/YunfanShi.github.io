import assert from 'node:assert/strict';
import { createRequire } from 'node:module';
import { mkdir, writeFile } from 'node:fs/promises';
import { createEmptyScheduleState } from '../src/lib/learning/schedule-control.ts';
import { applyPracticeSession, type PracticeSession } from '../src/lib/learning/practice-timer.ts';

const require = createRequire(import.meta.url);
const { chromium } = require(process.env.JACKYUN_PLAYWRIGHT_PATH || 'playwright');
const base = process.env.JACKYUN_TEST_URL || 'http://localhost:3116';
const out = process.env.JACKYUN_SCREENSHOT_DIR || 'artifacts/verification/practice-record-content';
await mkdir(out, { recursive: true });
const results: unknown[] = [];
const browser = await chromium.launch({ headless: true, channel: 'msedge' });
try {
  for (const width of [390, 1024, 1440]) {
    let seed = createEmptyScheduleState(); seed.settings.tutorialSeenVersion = 1;
    seed.timetable = { version: 1, name: 'Practice content test', courses: [{ id: 'mec', name: 'AL力学 1 AL Mechanics 1', color: '#4285f4', review: false, sessions: [{ day: 3, start: '08:00', end: '09:00' }] }] };
    const session: PracticeSession = { id: 'legacy-session', date: '2026-10-14', subject: 'AL力学 1 AL Mechanics 1', courseId: 'mec', presetFamily: 'mechanics', source: 'B', independent: false, scope: '', mode: 'normal', index: 0, updatedAt: 1791950400000, finished: true, questions: [1, 2, 3].map(n => ({ id: `q${n}`, name: `第 ${n} 题`, typeId: 'mechanics-basic', typeName: '受力分析', limitSeconds: 600, elapsedMs: 362699, startedAt: null, result: 'correct', blocked: false, node: '', cause: '', retest: '' })) };
    seed = applyPracticeSession(seed, session);
    const context = await browser.newContext({ viewport: { width, height: 1000 }, hasTouch: width !== 1440, timezoneId: 'Asia/Shanghai' });
    await context.addInitScript(seed => { if (!localStorage.getItem('jackyun_schedule_control_v1')) localStorage.setItem('jackyun_schedule_control_v1', JSON.stringify(seed)); }, seed);
    const page = await context.newPage(); const errors: string[] = [];
    page.on('pageerror', (error: Error) => errors.push(error.message));
    await page.clock.install({ time: new Date('2026-10-14T12:00:00+08:00') });
    await page.goto(base + '/schedule');
    const panel = page.getByRole('region', { name: '练习记录与本周指标', exact: true });
    await panel.waitFor({ timeout: 60000 });
    const metrics = panel.locator('[data-practice-metrics]');
    await metrics.getByText('3 题 · 1 次', { exact: true }).waitFor({ timeout: 60000 });
    await metrics.getByText('100%', { exact: true }).waitFor();
    await panel.getByRole('button', { name: '独立新题', exact: true }).click();
    await metrics.getByText('0 题 · 0 次', { exact: true }).waitFor();
    await panel.getByText('训练记录与修正', { exact: true }).click();
    await panel.getByText(/独立新题排除：未标记独立新题尝试/).waitFor();
    assert.ok((await panel.textContent())?.includes('18.1 分钟'));
    assert.ok(!(await panel.textContent())?.includes('18.134'));
    await panel.getByRole('link', { name: '查看或修改逐题报告', exact: true }).click();
    const frame = page.frameLocator('iframe[title="练习计时器"]');
    await frame.locator('#report').waitFor({ state: 'visible' });
    await frame.locator('#editContent').click();
    await frame.locator('#editContentType').selectOption('homework');
    await frame.locator('#editScope').fill('Mechanics Homework 8');
    await frame.locator('#editQuestionRange').fill('Q1–3');
    await frame.locator('#editUnit').fill('Forces');
    await frame.locator('#editSubsection').fill('Connected particles');
    await frame.locator('#editSource').selectOption('homework');
    await frame.locator('#editIndependent').check();
    await frame.locator('#saveContent').click();
    await page.waitForFunction(() => JSON.parse(localStorage.getItem('jackyun_schedule_control_v1')!).timedPracticeRecords[0].contentType === 'homework');
    await frame.locator('#reportMeta').getByText(/HOMEWORK 作业 · Mechanics Homework 8 · Q1–3/).waitFor();
    await page.screenshot({ path: `${out}/report-${width}.png` });
    await frame.locator('#newSession').click();
    assert.equal(await frame.locator('#scope').isDisabled(), true, 'name follows content selection');
    await frame.locator('#create').click();
    await frame.locator('#notice').getByText('请先选择练习内容类型，再填写具体名称。', { exact: true }).waitFor();
    await frame.locator('#contentType').selectOption('textbook');
    await frame.locator('#scope').fill('Mechanics Textbook Chapter 4');
    await page.screenshot({ path: `${out}/setup-${width}.png` });
    await page.goto(base + '/schedule');
    await metrics.getByText('3 题 · 1 次', { exact: true }).waitFor();
    await panel.getByRole('button', { name: '记录训练或作业抵扣' }).click();
    const form = panel.getByRole('form', { name: '限时训练记录' });
    assert.equal(await form.getByLabel('具体名称', { exact: true }).isDisabled(), true);
    await form.getByLabel('练习内容', { exact: true }).selectOption('exam');
    await form.getByLabel('具体名称', { exact: true }).fill('October Mechanics Mock');
    await form.getByLabel('题库类型', { exact: true }).selectOption('C');
    await form.getByLabel('科目', { exact: true }).selectOption(session.subject);
    await form.getByLabel('实际用时 分钟', { exact: true }).fill('12');
    await form.getByLabel('✓ 正确且按时', { exact: true }).fill('1');
    await form.getByLabel('△ 正确但超时', { exact: true }).fill('1');
    await form.getByLabel('○ 错误 无思路 求助', { exact: true }).fill('1');
    await form.getByLabel('最高影响的一个卡点', { exact: true }).fill('受力分析');
    await form.getByText('补充信息（选填）', { exact: true }).click();
    await form.getByLabel('题号或范围', { exact: true }).fill('Q4–6');
    await form.getByLabel('单元', { exact: true }).fill('Forces');
    await form.getByLabel('小节（可选）', { exact: true }).fill('Friction');
    await form.getByLabel('下一次新题复测', { exact: true }).fill('换两道受力分析新题');
    await form.getByLabel('其中无从下手', { exact: true }).fill('1');
    await form.getByRole('heading').scrollIntoViewIfNeeded();
    await page.screenshot({ path: `${out}/form-${width}.png` });
    await form.getByRole('button', { name: '保存训练证据' }).click();
    await metrics.getByText('6 题 · 2 次', { exact: true }).waitFor();
    await metrics.getByText('67%', { exact: true }).waitFor();
    await metrics.getByText('1 / 1 题', { exact: true }).waitFor();
    await page.reload();
    await metrics.getByText('6 题 · 2 次', { exact: true }).waitFor();
    await panel.getByRole('button', { name: '独立新题', exact: true }).click();
    await metrics.getByText('3 题 · 1 次', { exact: true }).waitFor();
    await metrics.getByText('100%', { exact: true }).waitFor();
    await panel.getByText('训练记录与修正', { exact: true }).click();
    await panel.getByText(/EXAM 考试 · October Mechanics Mock · Q4–6/).waitFor();
    await panel.getByText(/不足 20 分钟，尚不抵扣周训练/).waitFor();
    await panel.getByRole('button', { name: '全部训练', exact: true }).click();
    const grouped = panel.getByRole('region', { name: '练习分类统计', exact: true });
    await grouped.getByRole('button', { name: '单元', exact: true }).click();
    await grouped.getByRole('heading', { name: /Forces/ }).waitFor();
    await grouped.getByRole('button', { name: '小节', exact: true }).click();
    await grouped.getByRole('heading', { name: /Connected particles/ }).waitFor();
    await grouped.getByRole('heading', { name: /Friction/ }).waitFor();
    assert.equal(await grouped.locator('[data-practice-breakdown]').count(), 2);
    assert.equal(await page.evaluate(() => document.documentElement.scrollWidth <= innerWidth + 1), true);
    await grouped.scrollIntoViewIfNeeded();
    await page.screenshot({ path: `${out}/schedule-${width}.png` });
    assert.deepEqual(errors, []);
    results.push({ width, passed: true, checks: ['legacy 18.1 minute record counted', 'new-scope explanation', 'timer content edit', 'selection before name', 'optional form details', 'all/new metrics', 'subject/unit/subsection breakdowns', 'reload', 'no overflow', 'no page errors'] });
    await context.close();
  }
} finally { await browser.close(); }
await writeFile(`${out}/results.json`, JSON.stringify(results, null, 2));
console.log(JSON.stringify(results));
