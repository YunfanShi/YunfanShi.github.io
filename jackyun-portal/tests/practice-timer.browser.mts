import assert from 'node:assert/strict';
import { createRequire } from 'node:module';
import { mkdir, writeFile } from 'node:fs/promises';
import { createEmptyScheduleState } from '../src/lib/learning/schedule-control.ts';
const require=createRequire(import.meta.url);
const {chromium}=require(process.env.JACKYUN_PLAYWRIGHT_PATH||'playwright');
const base=process.env.JACKYUN_TEST_URL||'http://localhost:3215';
const out=process.env.JACKYUN_SCREENSHOT_DIR||'artifacts/verification/practice-timer';
await mkdir(out,{recursive:true});
const browser=await chromium.launch({headless:true,channel:'msedge'});
const results:unknown[]=[];
try {for(const width of [1440,390]){
  const context=await browser.newContext({viewport:{width,height:1000},timezoneId:'Asia/Shanghai',hasTouch:width===390});
  const seed=createEmptyScheduleState();seed.settings.tutorialSeenVersion=1;
  await context.addInitScript(seed=>{if(!localStorage.getItem('jackyun_schedule_control_v1'))localStorage.setItem('jackyun_schedule_control_v1',JSON.stringify(seed));},seed);
  const page=await context.newPage();const errors:string[]=[];page.on('pageerror',(e:Error)=>errors.push(e.message));
  await page.clock.install({time:new Date('2026-10-13T12:00:00+08:00')});
  await page.goto(base+'/practice-timer');const f=page.frameLocator('iframe[title="练习计时器"]');
  await f.getByRole('button',{name:'进入练习',exact:true}).waitFor({timeout:90000});
  await f.locator('#subject').selectOption('Physics');await f.locator('#mode').selectOption('exam');await f.locator('#independent').check();await f.locator('#scope').fill('新题训练 Ch1 Q1–3');
  await page.clock.pauseAt(new Date('2026-10-13T12:01:00+08:00')); await f.getByRole('button',{name:'进入练习',exact:true}).click();
  await f.getByRole('button',{name:'专注全屏 ⛶',exact:true}).click();
  await page.waitForFunction(()=>document.querySelector('iframe[title="练习计时器"]')?.getBoundingClientRect().width===innerWidth);
  const frameBox=await page.locator('iframe[title="练习计时器"]').boundingBox();assert.equal(frameBox?.x,0);assert.equal(frameBox?.y,0);assert.equal(frameBox?.height,1000);
  assert.equal(await f.locator('#questionName').isVisible(),false);assert.equal(await f.locator('#focusTypeMenu').isVisible(),false);
  await f.locator('#focusTypeTrigger').click();await f.locator('#focusTypes').locator('[data-type="1"]').click();assert.match(await f.locator('#questionLabel').textContent(),/解释题/);
  await page.keyboard.press('1');assert.match(await f.locator('#questionLabel').textContent(),/选择题/);
  await page.keyboard.press('Space');assert.equal(await f.locator('#toggle').textContent(),'暂停计时');await page.keyboard.press('Space');
  await page.screenshot({path:`${out}/focus-${width}.png`});await page.keyboard.press('Escape');await f.locator('#questionName').waitFor({state:'visible'});
  await f.locator('#questionLimit').fill('1');await f.locator('#questionLimit').press('Tab');
  await f.getByRole('button',{name:'开始计时',exact:true}).click();await page.clock.runFor(42000);
  assert.equal(await f.locator('#encouragement').textContent(),'还来得及，先抓住关键步骤。');
  assert.equal(await f.locator('body').getAttribute('data-tone'),'yellow');
  assert.equal(await f.locator('#dial').evaluate(el=>getComputedStyle(el,'::before').animationName),'practice-orbit');
  await f.locator('#enterFocus').click();await page.screenshot({path:`${out}/focus-yellow-${width}.png`});await page.keyboard.press('Escape');
  await f.locator('#hero').click({position:{x:20,y:20}});await page.keyboard.press('Space');assert.equal(await f.locator('#toggle').textContent(),'开始计时');
  await page.clock.runFor(15000);assert.equal(await f.locator('#totalTime').textContent(),'00:42');
  await page.keyboard.press('Space');await page.clock.runFor(14000);
  assert.equal(await f.locator('body').getAttribute('data-tone'),'red');assert.equal(await f.locator('#dial').evaluate(el=>getComputedStyle(el,'::before').animationDuration),'2.2s');
  await f.locator('#enterFocus').click();await page.screenshot({path:`${out}/focus-red-${width}.png`});await page.keyboard.press('Escape');
  await page.clock.runFor(6000);assert.match(await f.locator('#encouragement').textContent(),/已超时/);
  await f.getByText('批改与卡点 可在报告中补填',{exact:true}).click(); await f.locator('#result').selectOption('correct');await f.locator('#cause').selectOption('时间与策略');
  await f.getByRole('button',{name:'下一题 →',exact:true}).click();await f.getByRole('button',{name:'开始计时',exact:true}).click();await page.clock.runFor(8000);await f.getByRole('button',{name:'暂停计时',exact:true}).click();
  assert.equal(await f.locator('#totalTime').textContent(),'01:10');
  await f.locator('#questionName').fill('自定义 Q2');await f.locator('#questionName').press('Tab');
  await f.locator('#result').selectOption('wrong');await f.locator('#blocked').check();
  await f.locator('#queue').getByRole('button',{name:'1',exact:true}).click();assert.match(await f.locator('#used').textContent(),/01:02/);
  await f.locator('#queue').getByRole('button',{name:'2',exact:true}).click();assert.match(await f.locator('#used').textContent(),/00:08/);
  await page.waitForFunction(()=>JSON.parse(localStorage.getItem('jackyun_schedule_control_v1')||'{}').practiceSessions?.[0]?.questions[1]?.name==='自定义 Q2');
  assert.ok(await f.locator('body').evaluate(el=>el.scrollWidth<=innerWidth+1));
  await f.locator('#workspace').screenshot({path:`${out}/workspace-${width}.png`});
  await page.reload();await f.getByRole('button',{name:/Physics · 恢复草稿/}).click();await f.locator('#workspace').waitFor({state:'visible'});assert.equal(await f.locator('#toggle').textContent(),'开始计时');assert.match(await f.locator('#used').textContent(),/00:08/);
  await f.getByRole('button',{name:'结束并查看报告',exact:true}).click();
  await f.locator('#reportRows').getByText('△ 正确但超时',{exact:true}).waitFor();await f.locator('#reportRows').getByText('○ 错误 / 求助',{exact:true}).waitFor();
  await page.waitForFunction(()=>JSON.parse(localStorage.getItem('jackyun_schedule_control_v1')||'{}').timedPracticeRecords?.length===1);
  const data=await page.evaluate(()=>JSON.parse(localStorage.getItem('jackyun_schedule_control_v1')!));assert.equal(data.timedPracticeRecords[0].overtime,1);assert.equal(data.timedPracticeRecords[0].failed,1);assert.equal(data.timedPracticeRecords[0].blocked,1);
  await f.getByRole('button',{name:'加入 Schedule 新题复测',exact:true}).click();await f.getByRole('button',{name:'加入 Schedule 新题复测',exact:true}).click();
  await page.waitForFunction(()=>JSON.parse(localStorage.getItem('jackyun_schedule_control_v1')||'{}').manualTasks?.length===1);
  await f.locator('#report').screenshot({path:`${out}/report-${width}.png`});
  await f.getByRole('button',{name:'时间设置',exact:true}).click();await f.locator('#customSubject').fill('自定义科目');await f.getByRole('button',{name:'添加科目与预设',exact:true}).click();
  await f.getByRole('button',{name:'保存时间设置',exact:true}).click();await page.waitForFunction(()=>JSON.parse(localStorage.getItem('jackyun_schedule_control_v1')||'{}').practiceTimerConfig?.subjects?.['自定义科目']);
  await f.locator('#effectsEnabled').uncheck();await f.locator('#soundEnabled').uncheck();await f.locator('#soundVolume').fill('0');await f.getByRole('button',{name:'保存时间设置',exact:true}).click();
  await page.waitForFunction(()=>JSON.parse(localStorage.getItem('jackyun_schedule_control_v1')||'{}').practiceTimerConfig?.effects===false);assert.equal(await f.locator('body').getAttribute('data-effects'),'false');
  await page.goto(base+'/schedule');await page.getByRole('link',{name:/练习计时器/}).waitFor({timeout:60000});await page.getByText('逐题报告与薄弱题型 · 1 次练习').waitFor();
  await page.goto(base+'/login');await page.getByRole('heading',{name:'欢迎回来'}).waitFor();await page.screenshot({path:`${out}/login-${width}.png`,fullPage:true});
  assert.ok(await page.evaluate(()=>document.documentElement.scrollWidth<=innerWidth+1));assert.deepEqual(errors,[]);
  results.push({width,passed:true,checks:['timer-only fullscreen','hidden metadata','corner type menu','fullscreen keyboard and Escape','pause/switch independence','percentage colors','yellow/red animation','animation and sound settings','overtime','refresh recovery','Schedule metrics','retest dedup','custom presets','login layout']});await context.close();
}}finally{await browser.close();}
await writeFile(`${out}/results.json`,JSON.stringify(results,null,2));console.log(JSON.stringify(results));
