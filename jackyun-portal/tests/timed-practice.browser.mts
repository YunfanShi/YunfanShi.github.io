import assert from 'node:assert/strict';
import { createRequire } from 'node:module';
import { mkdir, writeFile } from 'node:fs/promises';
import { createEmptyScheduleState } from '../src/lib/learning/schedule-control.ts';
const require = createRequire(import.meta.url);
const { chromium } = require(process.env.JACKYUN_PLAYWRIGHT_PATH || 'playwright');
const base = process.env.JACKYUN_TEST_URL || 'http://localhost:3113';
const out = process.env.JACKYUN_SCREENSHOT_DIR || 'artifacts/verification/timed-practice';
await mkdir(out, { recursive: true });
const browser = await chromium.launch({ headless: true, channel: 'msedge' });
const results: unknown[] = [];
try {
  for (const width of [390, 1440]) {
    const context = await browser.newContext({ viewport: { width, height: 900 }, hasTouch: width === 390, timezoneId: 'Asia/Shanghai' });
    const seed = createEmptyScheduleState(); seed.settings.tutorialSeenVersion = 1;
    await context.addInitScript(seed => { if (!localStorage.getItem('jackyun_schedule_control_v1')) localStorage.setItem('jackyun_schedule_control_v1', JSON.stringify(seed)); }, seed);
    const page = await context.newPage(); const errors: string[] = [];
    page.on('pageerror', (error: Error) => errors.push(error.message));
    await page.clock.install({ time: new Date('2026-10-13T12:00:00+08:00') });
    await page.goto(base + '/schedule');
    const panel = page.getByRole('region', { name: '本周限时新题', exact: true });
    await panel.waitFor({ timeout: 60000 });
    await panel.getByText(/2026-10-12 — 2026-10-18/).waitFor();
    await panel.getByRole('button', { name: '加入所选日' }).first().click();
    await page.waitForFunction(() => JSON.parse(localStorage.getItem('jackyun_schedule_control_v1') || '{}').manualTasks.length === 1);
    assert.equal(await panel.getByRole('button', { name: '加入所选日' }).first().isDisabled(), true);
    await panel.getByRole('button', { name: '记录训练或作业抵扣' }).click();
    const form = panel.getByRole('form', { name: '限时训练记录' });
    await form.getByLabel(/^科目/).selectOption('Physics');
    await form.getByLabel(/^题库类型/).selectOption('homework');
    await form.getByLabel('题目来源或编号').fill('首次作业 Q1–4');
    await form.getByRole('checkbox').check();
    await form.getByLabel('✓ 正确且按时', { exact: true }).fill('2');
    await form.getByLabel('△ 正确但超时', { exact: true }).fill('1');
    await form.getByLabel('○ 错误 无思路 求助', { exact: true }).fill('1');
    await form.getByLabel('其中无从下手', { exact: true }).fill('1');
    await form.getByLabel('最高影响的一个卡点').fill('受力分析');
    assert.equal(await page.evaluate(() => document.documentElement.scrollWidth <= innerWidth + 1), true);
    await form.screenshot({ path: `${out}/form-${width}.png` });
    await form.getByRole('button', { name: '保存训练证据' }).click();
    await panel.getByText('4 题 · 1 次', { exact: true }).waitFor();
    await panel.getByText('50%', { exact: true }).waitFor();
    await page.reload();
    await panel.getByText('4 题 · 1 次', { exact: true }).waitFor();
    await panel.getByText('Physics · 已有训练证据', { exact: true }).waitFor();
    const saved = await page.evaluate(() => JSON.parse(localStorage.getItem('jackyun_schedule_control_v1')!));
    assert.equal(saved.timedPracticeRecords[0].source, 'homework');
    assert.equal(saved.manualTasks.length, 1);
    await panel.getByText('训练记录与修正', { exact: true }).click();
    await panel.getByRole('button', { name: '修改', exact: true }).click();
    await form.getByLabel(/^题库类型/).selectOption('A');
    await form.getByRole('button', { name: '保存训练证据' }).click();
    await panel.getByText('暂无证据', { exact: true }).waitFor();
    await panel.getByText('0 题 · 0 次', { exact: true }).waitFor();
    await page.reload();
    await panel.getByText('0 题 · 0 次', { exact: true }).waitFor();
    await panel.screenshot({ path: `${out}/schedule-${width}.png` });
    await panel.getByRole('link', { name: '查看限时新题完整方法 →', exact: true }).click();
    const frame = page.frameLocator('iframe');
    await frame.getByText('限时新题：先独立动笔，再修最高影响卡点', { exact: true }).waitFor({ timeout: 60000 });
    await frame.getByText('三门主科固定训练 + 一门轮换', { exact: true }).waitFor();
    await page.screenshot({ path: `${out}/guide-${width}.png`, fullPage: true });
    assert.equal(await frame.locator('body').evaluate(element => element.scrollWidth <= innerWidth + 1), true);
    assert.deepEqual(errors, []);
    results.push({ width, passed: true, checked: ['plan once', 'homework credit', 'first-attempt metrics', 'reload', 'repair exclusion', 'guide deep link', 'no overflow'] });
    await context.close();
  }
} finally { await browser.close(); }
await writeFile(`${out}/results.json`, JSON.stringify(results, null, 2));
console.log(JSON.stringify(results));
